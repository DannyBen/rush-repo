#!/usr/bin/env bash
source "$REPO_PATH/lib.sh"

package_install openai-codex || fail "failed to install openai-codex"

# TEMPORARY MIGRATION: Remove after users have migrated from the old
# GitHub bundle installation to the Arch package.
if [[ -f /usr/local/bin/codex ]] &&
  [[ -f /usr/local/bin/codex-code-mode-host ]] &&
  [[ -f /usr/local/bin/codex-resources/bwrap ]]; then
  say "removing legacy codex installation"
  bin_uninstall codex
  bin_uninstall codex-code-mode-host
  sudo rm -rf /usr/local/bin/codex-resources
fi
